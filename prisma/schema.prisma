// Schema do MITIZ Mesas.
//
// Referências: CLAUDE.md seções 7 (estados), 8 (regras de negócio),
// 13 (estrutura de domínio) e ADR 0001
// (docs/architecture/decisions/0001-decisoes-tecnicas-iniciais.md).
//
// Convenções adotadas neste schema:
// - Todo valor monetário é Decimal(10, 2) — nunca float (regra 20/21).
// - Todo horário é armazenado com timezone (timestamptz), em UTC; a
//   apresentação em America/Sao_Paulo é responsabilidade da aplicação
//   (regra 23).
// - Nada financeiro ou operacional crítico é apagado por FK cascade:
//   relações para Product, ServiceSession, Order, Payment, Discount,
//   ServiceCharge, User (quando autor de uma ação) usam onDelete Restrict
//   ou SetNull, nunca Cascade (regras 7/8).
// - Preço e nomes são "congelados" no item lançado (unitPrice,
//   productNameAtOrder, modifierNameAtOrder, priceDeltaAtOrder) para que
//   alterar o cadastro não altere vendas já registradas (regras 9/10).
// - Cancelamentos e estornos são sempre um novo estado + auditoria, nunca
//   uma exclusão (regra 6/7/8) — por isso não há onDelete Cascade em
//   nenhuma tabela financeira.
// - Toda requisição crítica tem uma chave de idempotência única no banco
//   (Order.idempotencyKey, Payment.idempotencyKey) — regra 18/19.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Connection string via connection pooler do Supabase (pgbouncer) — usada
  // pela aplicação em runtime.
  url       = env("DATABASE_URL")
  // Connection string direta — exigida pelo Prisma Migrate, que não
  // funciona corretamente através do pooler.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums — máquinas de estado (CLAUDE.md seção 7)
// ---------------------------------------------------------------------------

enum TableStatus {
  FREE
  OCCUPIED
  WAITING_SERVICE
  ORDER_IN_PROGRESS
  WAITING_CLOSING
  PARTIALLY_PAID
  RESERVED
  BLOCKED
}

enum ServiceSessionStatus {
  OPEN
  WAITING_CLOSING
  PARTIALLY_PAID
  PAID
  CLOSED
  REOPENED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  SENT
  RECEIVED
  IN_PREPARATION
  READY
  DELIVERED
  PARTIALLY_CANCELLED
  CANCELLED
}

enum OrderItemStatus {
  DRAFT
  SENT
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLATION_REQUESTED
  CANCELLED
}

enum PrintJobStatus {
  PENDING
  PROCESSING
  PRINTED
  FAILED
  CANCELLED
}

// Tipo do ticket impresso — CLAUDE.md seção 20.
enum PrintJobType {
  NEW_ORDER
  COMPLEMENT
  CANCELLATION
  REPRINT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Ponto da carne (CLAUDE.md seção 4/9). NAO_SE_APLICA cobre itens que não
// são carne (bebidas, acompanhamentos).
enum MeatPoint {
  MAL_PASSADO
  AO_PONTO_PARA_MAL
  AO_PONTO
  AO_PONTO_PARA_BEM
  BEM_PASSADO
  NAO_SE_APLICA
}

// ---------------------------------------------------------------------------
// Unidade / multi-tenant (ADR 0001, item 6 — preparado, sem UI no MVP)
// ---------------------------------------------------------------------------

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("America/Sao_Paulo")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users             User[]
  tables            Table[]
  categories        Category[]
  products          Product[]
  productionSectors ProductionSector[]
  printers          Printer[]
  paymentMethods    PaymentMethod[]
  auditLogs         AuditLog[]

  @@map("restaurants")
}

// ---------------------------------------------------------------------------
// Identidade e acesso
// ---------------------------------------------------------------------------

model Role {
  id        String   @id @default(cuid())
  // Código técnico estável (ex.: ADMIN, CASHIER, WAITER, KITCHEN) — CLAUDE.md
  // seção 5. Perfis fixos no MVP; tabela existe para permitir extensão sem
  // migração de schema.
  name      String   @unique
  label     String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  // Código técnico, ex.: "orders.create", "payments.register".
  code        String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String  @id @default(cuid())
  restaurantId String
  roleId       String
  name         String
  email        String  @unique
  // Referência lógica ao usuário em auth.users (Supabase Auth) — não é uma
  // foreign key de banco de fato, porque auth.users vive em um schema que o
  // Prisma não gerencia. Supabase guarda a credencial (senha); esta tabela
  // guarda o perfil da aplicação (restaurante, papel, permissões).
  // Ver ADR 0002 (docs/architecture/decisions/0002-adocao-supabase.md).
  authUserId   String  @unique
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  waiterSessions        ServiceSession[] @relation("SessionWaiter")
  ordersCreated         Order[]          @relation("OrderWaiter")
  cancelledOrderItems   OrderItem[]      @relation("OrderItemCancelledBy")
  discountsApplied      Discount[]       @relation("DiscountAppliedBy")
  serviceChargesApplied ServiceCharge[]  @relation("ServiceChargeAppliedBy")
  paymentsRegistered    Payment[]        @relation("PaymentRegisteredBy")
  paymentsVoided        Payment[]        @relation("PaymentVoidedBy")
  auditLogs             AuditLog[]

  @@index([restaurantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Setores de produção e impressão (CLAUDE.md seções 6 e 20; ADR 0001 item 3)
// ---------------------------------------------------------------------------

model ProductionSector {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  // "Sem impressão" é um setor válido (CLAUDE.md seção 6) — hasPrinting
  // controla se um PrintJob deve de fato ser gerado para este setor.
  hasPrinting  Boolean @default(true)
  sortOrder    Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  products   Product[]
  orderItems OrderItem[]
  printJobs  PrintJob[]

  @@unique([restaurantId, name])
  @@map("production_sectors")
}

// Impressora física. No MVP existe um único registro ativo por restaurante
// (impressora térmica única, ADR 0001 item 3) — o modelo já suporta mais de
// uma para não exigir migração quando isso mudar.
model Printer {
  id             String  @id @default(cuid())
  restaurantId   String
  name           String
  // Detalhe de conexão do agente local (host/porta/identificador) — definido
  // no Módulo 7, quando o agente físico for implementado.
  connectionInfo String?
  // Hash (SHA-256) do token que o agente local usa para autenticar contra
  // /api/print-jobs — nunca guardamos o token em texto puro (mesmo racional
  // de senha). Nulo até alguém gerar um token pela tela /admin/impressoras;
  // sem token, essa impressora não consegue puxar a fila.
  agentTokenHash String?
  active         Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  printJobs  PrintJob[]

  @@unique([restaurantId, name])
  @@map("printers")
}

// ---------------------------------------------------------------------------
// Mesas e atendimento
// ---------------------------------------------------------------------------

model Table {
  id           String      @id @default(cuid())
  restaurantId String
  // Número ou nome livre (ex.: "1", "Varanda 3") — CLAUDE.md seção 10.
  number       String
  capacity     Int?
  status       TableStatus @default(FREE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  serviceSessions ServiceSession[]

  @@unique([restaurantId, number])
  @@map("tables")
}

// Um atendimento por mesa. A regra "uma mesa só pode ter um atendimento
// ativo por vez" (CLAUDE.md regra 1) não é totalmente expressável em uma
// constraint declarativa do Prisma (ela é condicional ao status). Fica
// registrada aqui e deve ser reforçada com um índice único parcial em SQL
// na primeira migration real (ver docs/database/schema.md):
//
//   CREATE UNIQUE INDEX service_sessions_one_active_per_table
//     ON service_sessions (table_id)
//     WHERE status IN ('OPEN', 'WAITING_CLOSING', 'PARTIALLY_PAID');
//
// até lá, a regra deve ser validada também na camada de aplicação dentro de
// uma transação.
model ServiceSession {
  id              String               @id @default(cuid())
  tableId         String
  waiterId        String
  status          ServiceSessionStatus @default(OPEN)
  guestCount      Int
  responsibleName String?

  // Valores em cache, recalculados de forma transacional a cada mutação
  // relevante (pedido, pagamento, desconto, taxa) — evita recomputar toda a
  // comanda a cada tela aberta pelo caixa. Nunca a única fonte de verdade:
  // sempre derivados de Order/OrderItem/Payment/Discount/ServiceCharge.
  subtotalAmount      Decimal @default(0) @db.Decimal(10, 2)
  discountAmount      Decimal @default(0) @db.Decimal(10, 2)
  serviceChargeAmount Decimal @default(0) @db.Decimal(10, 2)
  totalAmount         Decimal @default(0) @db.Decimal(10, 2)
  paidAmount          Decimal @default(0) @db.Decimal(10, 2)
  balanceAmount       Decimal @default(0) @db.Decimal(10, 2)

  openedAt     DateTime  @default(now()) @db.Timestamptz(6)
  closedAt     DateTime? @db.Timestamptz(6)
  cancelledAt  DateTime? @db.Timestamptz(6)
  cancelReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  table  Table @relation(fields: [tableId], references: [id], onDelete: Restrict)
  waiter User  @relation("SessionWaiter", fields: [waiterId], references: [id], onDelete: Restrict)

  guests         Guest[]
  orders         Order[]
  payments       Payment[]
  discounts      Discount[]
  serviceCharges ServiceCharge[]

  @@index([tableId])
  @@index([status])
  // getTableWithActiveSession (chamada em quase toda tela) filtra pelos
  // dois juntos — índice composto cobre essa consulta específica melhor
  // que os dois separados (docs/performance/optimization-plan.md, Fase
  // 5). Sem impacto medido no volume atual (6-8 mesas); custo de manter é
  // zero.
  @@index([tableId, status])
  @@map("service_sessions")
}

model Guest {
  id               String   @id @default(cuid())
  serviceSessionId String
  name             String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  serviceSession ServiceSession @relation(fields: [serviceSessionId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]

  @@index([serviceSessionId])
  @@map("guests")
}

// ---------------------------------------------------------------------------
// Cardápio
// ---------------------------------------------------------------------------

model Category {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   Product[]

  @@unique([restaurantId, name])
  @@map("categories")
}

model Product {
  id              String  @id @default(cuid())
  restaurantId    String
  categoryId      String
  defaultSectorId String
  name            String
  description     String?
  // Preço vigente — alterar este campo nunca modifica OrderItem.unitPrice já
  // gravado (regra 9/10). Ver congelamento em OrderItem.
  price           Decimal @db.Decimal(10, 2)
  available       Boolean @default(true)
  active          Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  defaultSector ProductionSector @relation(fields: [defaultSectorId], references: [id], onDelete: Restrict)

  modifierGroups ProductModifierGroup[]
  orderItems     OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("products")
}

model ProductModifierGroup {
  id        String  @id @default(cuid())
  productId String
  name      String
  required  Boolean @default(false)
  minSelect Int     @default(0)
  maxSelect Int     @default(1)
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifiers ProductModifier[]

  @@map("product_modifier_groups")
}

model ProductModifier {
  id         String  @id @default(cuid())
  groupId    String
  name       String
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  active     Boolean @default(true)
  sortOrder  Int     @default(0)

  group              ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@map("product_modifiers")
}

// ---------------------------------------------------------------------------
// Pedidos
// ---------------------------------------------------------------------------

model Order {
  id               String      @id @default(cuid())
  serviceSessionId String
  waiterId         String
  // Número sequencial do pedido dentro do atendimento (não global).
  sequenceNumber   Int
  status           OrderStatus @default(DRAFT)
  // Garante que duplo toque / reenvio de rede não crie dois pedidos
  // (regra 18/19). Gerada pelo cliente (UUID) e única no banco.
  idempotencyKey   String      @unique

  sentAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  serviceSession ServiceSession @relation(fields: [serviceSessionId], references: [id], onDelete: Restrict)
  waiter         User           @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: Restrict)

  items     OrderItem[]
  printJobs PrintJob[]

  @@unique([serviceSessionId, sequenceNumber])
  @@index([serviceSessionId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  sectorId  String
  guestId   String?

  // Nome e preço "congelados" no momento do lançamento — alterar o produto
  // depois não muda o que já foi vendido (regra 9/10).
  productNameAtOrder String
  unitPrice          Decimal         @db.Decimal(10, 2)
  quantity           Int
  meatPoint          MeatPoint?
  notes              String?
  status             OrderItemStatus @default(DRAFT)

  cancelReason  String?
  cancelledById String?
  cancelledAt   DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  order       Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  sector      ProductionSector @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  guest       Guest?           @relation(fields: [guestId], references: [id], onDelete: SetNull)
  cancelledBy User?            @relation("OrderItemCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([sectorId])
  @@map("order_items")
}

model OrderItemModifier {
  id          String @id @default(cuid())
  orderItemId String
  modifierId  String

  // Congelados no momento do lançamento, mesmo racional do OrderItem.
  modifierNameAtOrder String
  priceDeltaAtOrder   Decimal @db.Decimal(10, 2)
  quantity            Int     @default(1)

  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Restrict)

  @@map("order_item_modifiers")
}

// ---------------------------------------------------------------------------
// Impressão (CLAUDE.md seção 20; ADR 0001 item 3)
// ---------------------------------------------------------------------------

model PrintJob {
  id        String  @id @default(cuid())
  orderId   String
  sectorId  String
  printerId String?

  type            PrintJobType
  status          PrintJobStatus @default(PENDING)
  // Conteúdo já montado do ticket (itens, mesa, garçom, horário, setor,
  // observações, tipo) — snapshot para reimpressão idêntica mesmo que dados
  // relacionados mudem depois.
  contentSnapshot Json
  attempts        Int            @default(0)
  lastError       String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  printedAt DateTime? @db.Timestamptz(6)

  order   Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sector  ProductionSector @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  printer Printer?         @relation(fields: [printerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([sectorId])
  @@map("print_jobs")
}

// ---------------------------------------------------------------------------
// Caixa e pagamentos
// ---------------------------------------------------------------------------

model PaymentMethod {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  active       Boolean @default(true)
  sortOrder    Int     @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  payments   Payment[]

  @@unique([restaurantId, name])
  @@map("payment_methods")
}

model Payment {
  id               String  @id @default(cuid())
  serviceSessionId String
  paymentMethodId  String
  amount           Decimal @db.Decimal(10, 2)
  // Garante que duplo toque não registre o mesmo pagamento duas vezes
  // (regra 18/19).
  idempotencyKey   String  @unique
  registeredById   String

  // Pagamentos nunca são apagados (regra 8) — estorno é registrado como
  // anulação (voidedAt/voidReason), mantendo o registro original.
  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?
  voidedById String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  serviceSession ServiceSession @relation(fields: [serviceSessionId], references: [id], onDelete: Restrict)
  paymentMethod  PaymentMethod  @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  registeredBy   User           @relation("PaymentRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)
  voidedBy       User?          @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([serviceSessionId])
  @@map("payments")
}

model Discount {
  id               String       @id @default(cuid())
  serviceSessionId String
  type             DiscountType
  // Percentual (0-100) ou valor fixo em R$, conforme "type".
  value            Decimal      @db.Decimal(10, 2)
  // Valor efetivo em R$ resultante da aplicação — congelado, não recalculado
  // se o total mudar depois.
  amountApplied    Decimal      @db.Decimal(10, 2)
  reason           String
  appliedById      String

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  serviceSession ServiceSession @relation(fields: [serviceSessionId], references: [id], onDelete: Restrict)
  appliedBy      User           @relation("DiscountAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)

  @@index([serviceSessionId])
  @@map("discounts")
}

model ServiceCharge {
  id               String  @id @default(cuid())
  serviceSessionId String
  percent          Decimal @db.Decimal(5, 2)
  amountApplied    Decimal @db.Decimal(10, 2)
  // Retirada da taxa pelo cliente — CLAUDE.md regra 16: fica registrada, não
  // apenas com percent = 0.
  waived           Boolean @default(false)
  waivedReason     String?
  appliedById      String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  serviceSession ServiceSession @relation(fields: [serviceSessionId], references: [id], onDelete: Restrict)
  appliedBy      User           @relation("ServiceChargeAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)

  @@index([serviceSessionId])
  @@map("service_charges")
}

// ---------------------------------------------------------------------------
// Auditoria (CLAUDE.md regra 22)
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String?
  // Ex.: "order_item.cancelled", "service_session.discount_applied".
  action       String
  // Ex.: "OrderItem", "ServiceSession".
  entityType   String
  entityId     String
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
