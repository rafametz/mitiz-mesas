# Copie este arquivo para .env e preencha os valores reais.
# Nunca commitar o .env real.
#
# Todos os valores abaixo vêm do painel do projeto Supabase
# (https://supabase.com/dashboard/project/_/settings/api e .../database).
# Ver docs/architecture/decisions/0002-adocao-supabase.md.

# --- Banco de dados (Prisma + Postgres do Supabase) ---
# Connection string via connection pooler (pgbouncer) — usada pela aplicação
# em runtime. Settings > Database > Connection string > "Transaction" mode.
DATABASE_URL=""
# Connection string direta — exigida pelo Prisma Migrate (não passa pelo
# pooler). Settings > Database > Connection string > "Session" mode.
DIRECT_URL=""

# --- Supabase (cliente) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Secreta — nunca expor ao cliente, usar só em código de servidor.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Aplicação ---
# Fuso horário de referência para exibição (armazenamento continua em UTC).
APP_TIMEZONE="America/Sao_Paulo"
APP_URL="http://localhost:3000"

# --- VHSYS (integração de vendas balcão / PDV, planejada 2026-08-25) ---
# Gerados no painel da VHSYS após instalar o app "Integração via API"
# (https://developers.vhsys.com.br/api/). Nunca commitar valores reais.
VHSYS_ACCESS_TOKEN=""
VHSYS_SECRET_ACCESS_TOKEN=""

# --- Fixture de teste (E2E) — opcional, só para rodar `npm run test:e2e` ---
# Credenciais impressas por `npm run prisma:seed` (usuário de teste, não é
# conta real). Sem isso definido, os testes de login/logout são pulados.
E2E_TEST_USER_EMAIL=""
E2E_TEST_USER_PASSWORD=""
