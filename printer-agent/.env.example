# Copie para .env e preencha. Nunca commitar o .env real.

# URL do app Next.js — o mesmo domínio do Vercel em produção, ou
# http://localhost:3000 se estiver testando contra o servidor local.
SERVER_URL="https://mitiz-mesas.vercel.app"

# Gerado em /admin/impressoras -> "Gerar novo token". Aparece em texto puro
# só uma vez, na hora de gerar — copie e cole aqui assim que gerar.
PRINT_AGENT_TOKEN=""

# Nome EXATO da impressora como aparece no Windows (Painel de Controle >
# Dispositivos e Impressoras — a Epson já instalada normalmente com o
# driver dela). Formato "printer:NOME" é o que a node-thermal-printer usa
# para mandar bytes ESC/POS crus pro spooler do Windows.
PRINTER_INTERFACE="printer:EPSON TM-T20"

# De quanto em quanto tempo o agente consulta a fila (milissegundos).
POLL_INTERVAL_MS=5000
