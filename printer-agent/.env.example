# Copie para .env e preencha. Nunca commitar o .env real.

# URL do app Next.js — o mesmo domínio do Vercel em produção, ou
# http://localhost:3000 se estiver testando contra o servidor local.
SERVER_URL="https://mitiz-mesas.vercel.app"

# Gerado em /admin/impressoras -> "Gerar novo token". Aparece em texto puro
# só uma vez, na hora de gerar — copie e cole aqui assim que gerar.
PRINT_AGENT_TOKEN=""

# Alvo do comando `copy /b` (cópia binária do Windows), que é como o
# agente manda os bytes crus (ESC/POS) pra impressora — sem instalar
# driver nenhum de terceiro. Duas opções, ver README.md "Descobrir o alvo
# da impressora" pra saber qual usar e como achar o valor certo:
#   - Compartilhamento: \\localhost\NOME_DO_COMPARTILHAMENTO
#   - Porta direta: USB001 (ou LPT1, COM3 etc.)
PRINTER_TARGET="\\\\localhost\\EPSON"

# De quanto em quanto tempo o agente consulta a fila (milissegundos).
POLL_INTERVAL_MS=5000
